# Regenerable verifier scratch / caches / logs
*.sqlite
*.sqlite-shm
*.sqlite-wal
_verify_*.log
_verify_baseline.log
_verify_profile.txt
_verify_prototype.bak.py
_measure_*.py
__pycache__/
*.pyc

# Local npm install
node_modules/

# Large regenerable / unrelated artifacts (rebuilt from source by the
# build + verify + viz scripts; not tracked by convention)
policies_prototype/
# No trailing slash: in Cursor agent worktrees this path is a SYMLINK to the
# main checkout's checkpoint cache (see .cursor/setup-worktree-unix.sh), and
# dir-only patterns (trailing /) don't match symlinks.
rl_move/sim/policies

# W&B credentials (placeholder template lives in git history only via
# docs; the real file must never be committed)
rl_move/sim/wandb.env

# CoreWeave CKS credentials (server + API token for remote training);
# the real file must never be committed
rl_move/sim/coreweave.env

# Robot runtime log streams (regenerated every run). The calibration
# artifacts logs/motor_model.json + logs/motor_dyn_* ARE tracked — they
# are the hardware ground truth for rl_move/sim fitting.
linux_control/logs/recv_stdout.txt
linux_control/logs/robot_events.jsonl
linux_control/logs/events.jsonl
linux_control/logs/errors.jsonl
joint_viz/
stl_prototype/
full_robot_viz/stl/

# Xometry order bundle: generated ON DEMAND by
# scripts/prepare_xometry_upload.py (or build_all.py --xometry) and no
# longer checked in (Aug 2026 cleanup).
xometry_upload/

# stl_reference/*.stl is covered by the repo-root *.stl rule; keep the
# directory's README.md trackable.

# Stray top-level scene dump (the canonical scene is full_robot_viz/scene.json)
/scene.json

# RL eval/preflight artifacts (videos, reports) — regenerable
/logs/
rl_move/sim/logs/

# W&B local run cache (created by any wandb.Api()/wandb.init() call,
# e.g. ops.sh wandbnote/wandbdump) — untracked runtime junk, same
# category as /logs/. Left uncovered 2026-08-10: spurious -dirty code
# markers refused a drain launch (snapshot.sh's dirty check didn't
# exclude it either — fixed alongside this).
wandb/
rl_move/wandb/
