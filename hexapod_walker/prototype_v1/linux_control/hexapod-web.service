[Unit]
Description=Hexapod web control panel (serves the drive UI on :8080)
After=network.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# %h = the service user's home dir. web_drive.py talks to the firmware over
# the local arduino-router monitor port (127.0.0.1:7500) and reconnects on
# its own, so no hard ordering against arduino-router.service is needed.
ExecStart=/usr/bin/python3 %h/web_drive.py
Restart=always
RestartSec=3

# Installed as a systemd USER service (no sudo):
#   mkdir -p ~/.config/systemd/user
#   cp hexapod-web.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now hexapod-web.service
#   loginctl enable-linger "$USER"      # start at boot without being logged in
# To run system-wide instead (needs sudo), set User=arduino + WantedBy=
# multi-user.target and drop it in /etc/systemd/system/.
#
# Binding port 443 (so the clean `https://hexapod.local` -- no port -- works
# for the browser Gamepad API): a USER service can't bind a privileged port,
# so web_drive.py falls back to :8443 unless the OS allows an unprivileged
# bind to 443.  Enable that ONCE (needs sudo), persisted across reboots:
#   sudo sh -c 'echo net.ipv4.ip_unprivileged_port_start=443 \
#       > /etc/sysctl.d/50-hexapod-lowport.conf \
#       && sysctl -w net.ipv4.ip_unprivileged_port_start=443'
#   systemctl --user restart hexapod-web
# After that web_drive binds :443 directly (it already tries 443 before 8443).
[Install]
WantedBy=default.target
