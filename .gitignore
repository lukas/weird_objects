# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Generated 3D / build artifacts (rebuild via `./run.sh <project>/<script>.py`)
*.stl
*.step
*.ply
*.dxf
**/panels.json
**/blender_assets/
**/polyhedra_stl/
**/jigs/

# Fastener-cache provenance breadcrumbs written by
# hexapod_walker/prototype/make_fastener_meshes.py (one line per
# cached STL recording which source -- STEP / user STL / openscad /
# parametric -- produced the mesh).  Regenerated on every
# `make regen-fasteners`; not source.
**/fasteners/*.cache.source.txt

# CAD validation-workflow outputs (rebuild via
# `make -C hexapod_walker/prototype check-cad`).  Contains cad_report.md
# plus per-part PNG renders under views/.
hexapod_walker/prototype/artifacts/

# Per-check sqlite cache populated by _verify_prototype.py; key is
# sha1(check source + hp / fr module source + STL bytes), evicted
# after 30 days.  Safe to delete by hand (forces a cold run).  Bust
# via --no-cache.
hexapod_walker/prototype/.verify_cache.sqlite
hexapod_walker/prototype/.verify_cache.sqlite-journal
hexapod_walker/prototype/.verify_cache.sqlite-wal
hexapod_walker/prototype/.verify_cache.sqlite-shm

# Cursor / editor / OS
.DS_Store
.vscode/
.idea/
.mcp.json

# Render scratch / WIP outputs (the canonical renders in chandelier/renders/
# are explicitly committed; everything else is treated as scratch)
test_*.png
*.bak

# RL training artefacts (large, regeneratable)
hexapod_walker/policies/
MUJOCO_LOG.TXT

# Local Netlify folder
.netlify

# Local board credentials / secrets -- NEVER commit
**/.board_secrets.env
.secrets/
